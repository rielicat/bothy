# Copy to deploy/.env (next to compose.yaml). Every value is optional; the
# defaults fit rootful Docker on a typical Linux host. install.sh fills in the
# Docker values for the host it runs on.

# Group that owns the Docker socket as containers see it, so sandboxd can use
# it without root. If it is wrong, `docker compose logs sandboxd` prints the
# value to use.
#   Rootful Docker on Linux:  stat -L -c %g /var/run/docker.sock
#   Docker Desktop (macOS, Windows and Linux): 0, the socket's group inside its VM
#   Rootless Docker: 0. Containers share dockerd's user namespace, where you
#     (the socket's owner) are root, so the socket appears as root:root inside.
DOCKER_GID=999

# Path of the container runtime socket on the host. Rootless Docker:
#   DOCKER_SOCK=$XDG_RUNTIME_DIR/docker.sock   (e.g. /run/user/1000/docker.sock)
# Docker Desktop: keep /var/run/docker.sock; it maps to the VM's socket.
DOCKER_SOCK=/var/run/docker.sock

# uid:gid sandboxd runs as. Rarely needs changing: rootless Docker works with
# the default plus DOCKER_GID=0 above (0:0 would also work there, as root of
# the user namespace is your unprivileged user, but is not needed).
SANDBOXD_USER=65532:65532

# Secret for the optional SearXNG service (docker compose --profile search up -d).
# install.sh writes a random value; otherwise generate one with:
#   openssl rand -hex 32
SEARXNG_SECRET=
