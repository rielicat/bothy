# Copy to deploy/.env (next to compose.yaml). Every value is optional; the
# defaults fit rootful Docker on a typical Linux host.

# Group that owns the Docker socket, so sandboxd can use it without root.
# Print it with:  stat -c %g /var/run/docker.sock
DOCKER_GID=999

# Path of the container runtime socket on the host. Rootless Docker:
#   DOCKER_SOCK=/run/user/1000/docker.sock
DOCKER_SOCK=/var/run/docker.sock

# uid:gid sandboxd runs as. Rootless Docker: the socket owner's uid:gid, e.g.
#   SANDBOXD_USER=1000:1000   (from: stat -c %u:%g "$DOCKER_SOCK")
SANDBOXD_USER=65532:65532

# Secret for the optional SearXNG service (docker compose --profile search up -d).
# install.sh writes a random value; otherwise generate one with:
#   openssl rand -hex 32
SEARXNG_SECRET=
