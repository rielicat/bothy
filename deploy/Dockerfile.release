# syntax=docker/dockerfile:1
# Release gateway image, built by goreleaser (dockers_v2) from the signed
# release binaries, which it places at $TARGETPLATFORM/bothy in the context.
# Keep the layout identical to deploy/Dockerfile (SPEC §2.3).

FROM --platform=$BUILDPLATFORM docker.io/library/busybox:1.37.0-musl@sha256:5cec3fc171c87218698e85a52af7087de727372aae264a787b8112901a5b0092 AS layout
RUN install -d -m 0700 -o 65532 -g 65532 /rootfs/data /rootfs/keys \
 && install -d -m 2770 -o 65532 -g 10001 /rootfs/work \
 && install -d -m 0755 /rootfs/run \
 && install -d -m 0770 -o 65532 -g 65532 /rootfs/run/bothy

FROM gcr.io/distroless/static-debian13:nonroot@sha256:e2e927ec666bae08560abb3c55d0659eceabb657f56b6782ab500a9fc7f555e3
ARG TARGETPLATFORM
COPY --from=layout /rootfs/ /
COPY --chmod=0755 $TARGETPLATFORM/bothy /bothy
ENV BOTHY_DEPLOYMENT=container
USER 65532:65532
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=3s --retries=3 --start-period=30s --start-interval=1s CMD ["/bothy", "healthcheck"]
ENTRYPOINT ["/bothy"]
CMD ["serve"]
